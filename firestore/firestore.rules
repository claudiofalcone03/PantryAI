rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ REGOLA TEMPORANEA — scade il 18 Giugno 2026
    // Permette lettura e scrittura a tutti (solo per sviluppo).
    // Sostituire con regole specifiche prima del deploy in produzione.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 6, 18);
    }

  }
}
